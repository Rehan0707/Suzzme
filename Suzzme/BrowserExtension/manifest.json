{
  "manifest_version": 3,
  "name": "Suzzme App Connections",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Connect supported app tabs to Suzzme with your approval.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect this app with Suzzme",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*.admin.typeform.com/*",
    "https://*.airtable.com/*",
    "https://*.analytics.google.com/*",
    "https://*.app.asana.com/*",
    "https://*.app.clickup.com/*",
    "https://*.app.contentful.com/*",
    "https://*.app.todoist.com/*",
    "https://*.app.ynab.com/*",
    "https://*.calendar.google.com/*",
    "https://*.classroom.google.com/*",
    "https://*.console.cloud.google.com/*",
    "https://*.docs.google.com/*",
    "https://*.drive.google.com/*",
    "https://*.eventbrite.com/*",
    "https://*.figma.com/*",
    "https://*.getharvest.com/*",
    "https://*.github.com/*",
    "https://*.gitlab.com/*",
    "https://*.linear.app/*",
    "https://*.linkedin.com/*",
    "https://*.mail.google.com/*",
    "https://*.meet.google.com/*",
    "https://*.notion.site/*",
    "https://*.notion.so/*",
    "https://*.outlook.live.com/*",
    "https://*.outlook.office.com/*",
    "https://*.pushbullet.com/*",
    "https://*.search.google.com/*",
    "https://*.sheets.google.com/*",
    "https://*.slack.com/*",
    "https://*.slides.google.com/*",
    "https://*.tasks.google.com/*",
    "https://*.todoist.com/*",
    "https://*.wakatime.com/*",
    "https://*.web.whatsapp.com/*",
    "https://admin.typeform.com/*",
    "https://airtable.com/*",
