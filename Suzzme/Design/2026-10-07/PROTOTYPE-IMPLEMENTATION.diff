+#if os(macOS)
+import SwiftUI
+
+struct MacMenuBarView: View {
+    @Environment(AppEnvironment.self) private var environment
+    @Environment(\.openWindow) private var openWindow
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var showsAssistant = false
+    @State private var draft = ""
+    @State private var submittedDraft = ""
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SuzzmeTheme.Spacing.medium) {
+            HStack(spacing: SuzzmeTheme.Spacing.small) {
+                SuzzmeFace(state: environment.presenceState,
+                    color: environment.invocation.presenceTheme.colors(for: colorScheme).face,
+                    animation: environment.invocation.presenceAnimation)
+                    .frame(width: SuzzmeTheme.Layout.touchTarget, height: SuzzmeTheme.Layout.touchTarget).accessibilityHidden(true)
+                VStack(alignment: .leading, spacing: SuzzmeTheme.Spacing.xxs) {
+                    Text("Suzzme").font(.headline)
+                    Text(environment.presenceState == .idle ? "Ready when you are" : SuzzmeAssistantPresentation.make(for: environment.presenceState).systemStatus)
+                        .font(.caption).foregroundStyle(SuzzmeTheme.textSecondary)
+                }
+            }
+            HStack {
+                TextField("Ask anything…", text: $draft).textFieldStyle(.roundedBorder).onSubmit(send)
+                Button(action: send) { Image(systemName: "arrow.up") }
+                    .disabled(draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                    .accessibilityLabel("Send question")
+            }
+            Button {
+                Task { await environment.invokeTransientVoice() }
+            } label: { Label("Talk to Suzzme", systemImage: "mic.fill").frame(maxWidth: .infinity, minHeight: SuzzmeTheme.Layout.touchTarget) }
+                .buttonStyle(.borderedProminent).tint(SuzzmeTheme.intelligencePrimary).suzzmeProminentContrast()
+            Divider()
+            HStack {
+                Button("Open Suzzme") { openWindow(id: "main") }
+                Spacer()
+                SettingsLink { Image(systemName: "gearshape") }.accessibilityLabel("Settings")
+            }
+        }
+        .padding(SuzzmeTheme.Layout.compactInset).frame(width: SuzzmeTheme.Layout.menuBarWidth)
+        .sheet(isPresented: $showsAssistant) {
+            AskSuzzmeView(initialText: submittedDraft, submitOnAppear: true).frame(width: 500, height: 600)
+        }
+    }
+    private func send() {
+        let question = draft.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !question.isEmpty else { return }
+        submittedDraft = question
+        draft = ""
+        showsAssistant = true
+    }
+}
+#endif
