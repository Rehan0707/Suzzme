+import SwiftUI
+
+/// The prototype's focused entrance, backed by the same companion as every surface.
+struct HomeView: View {
+    @Environment(AppEnvironment.self) private var environment
+    @Environment(AppRouter.self) private var router
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var draft = ""
+    @State private var submittedDraft = ""
+    @State private var showsAssistant = false
+    @State private var showsContext = false
+
+    var body: some View {
+        GeometryReader { geometry in
+            ScrollView {
+                VStack(spacing: SuzzmeTheme.Spacing.large) {
+                    VStack(spacing: SuzzmeTheme.Spacing.small) {
+                        Text("A little space to think.")
+                            .font(.subheadline).foregroundStyle(SuzzmeTheme.textSecondary)
+                        Text("What’s on your mind?")
+                            .font(.largeTitle.weight(.semibold))
+                            .multilineTextAlignment(.center)
+                            .accessibilityAddTraits(.isHeader)
+                    }
+                    .padding(.top, SuzzmeTheme.Spacing.large)
+                    SuzzmeFace(state: environment.presenceState,
+                        color: environment.invocation.presenceTheme.colors(for: colorScheme).face,
+                        lineWidth: 4, animation: environment.invocation.presenceAnimation,
+                        audioLevel: environment.voice.audioLevel,
+                        speechProgress: environment.voice.speechProgress)
+                        .frame(width: SuzzmeTheme.Layout.companionFace, height: SuzzmeTheme.Layout.companionFace)
+                        .accessibilityHidden(true)
+                    Text(environment.presenceState == .idle ? "Ready when you are" : SuzzmeAssistantPresentation.make(for: environment.presenceState).systemStatus)
+                        .font(.subheadline).foregroundStyle(SuzzmeTheme.textSecondary)
+                    Button(action: talk) {
+                        Label("Talk to Suzzme", systemImage: "mic.fill")
+                            .font(.headline).padding(.horizontal, SuzzmeTheme.Layout.compactInset)
+                            .frame(minHeight: SuzzmeTheme.Layout.touchTarget)
+                    }
+                    .buttonStyle(.borderedProminent)
+                    .tint(SuzzmeTheme.intelligencePrimary)
+                    .suzzmeProminentContrast()
+                    .keyboardShortcut("t", modifiers: [.command, .shift])
+                    VStack(spacing: SuzzmeTheme.Spacing.xxs) {
+                        suggestion("What’s ahead today?", symbol: "sun.max") { router.selection = .today }
+                        suggestion("Summarize my day", symbol: "text.alignleft") { router.selection = .briefing }
+                        suggestion("Choose useful context", symbol: "plus.circle") { showsContext = true }
+                    }
+                    .frame(maxWidth: SuzzmeTheme.Layout.suggestionWidth)
+                    Spacer(minLength: SuzzmeTheme.Spacing.large)
+                    composer
+                }
+                .padding(.horizontal, SuzzmeTheme.Layout.pageInset)
+                .padding(.vertical, SuzzmeTheme.Layout.compactInset)
+                .frame(maxWidth: SuzzmeTheme.Layout.companionWidth)
+                .frame(minHeight: max(0, geometry.size.height), alignment: .top)
+                .frame(maxWidth: .infinity)
+            }
+            .scrollBounceBehavior(.basedOnSize)
+        }
+        .background(SuzzmeTheme.pageBackground.ignoresSafeArea())
+        .sheet(isPresented: $showsAssistant) {
+            AskSuzzmeView(initialText: submittedDraft, focusInput: !submittedDraft.isEmpty, submitOnAppear: !submittedDraft.isEmpty)
+                #if os(macOS)
+                .frame(minWidth: 440, idealWidth: 560, minHeight: 560)
+                #endif
+        }
+        .sheet(isPresented: $showsContext) { ContextChooserView() }
+    }
+
+    private var composer: some View {
+        VStack(spacing: SuzzmeTheme.Spacing.small) {
+            HStack(alignment: .bottom, spacing: SuzzmeTheme.Spacing.xs) {
+                Button { showsContext = true } label: {
+                    Image(systemName: "plus").frame(width: SuzzmeTheme.Layout.touchTarget, height: SuzzmeTheme.Layout.touchTarget)
+                }
+                .buttonStyle(.plain).accessibilityLabel("Choose context")
+                TextField("Ask anything…", text: $draft, axis: .vertical)
+                    .textFieldStyle(.plain).lineLimit(1...4)
+                    .padding(.vertical, SuzzmeTheme.Spacing.small)
+                    .onSubmit(send)
+                    .accessibilityLabel("Your question")
+                Button(action: send) {
+                    Image(systemName: "arrow.up").font(.body.weight(.semibold))
+                        .frame(width: SuzzmeTheme.Layout.touchTarget, height: SuzzmeTheme.Layout.touchTarget)
+                }
+                .buttonStyle(.borderedProminent).tint(SuzzmeTheme.intelligencePrimary)
+                .suzzmeProminentContrast()
+                .disabled(draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                .accessibilityLabel("Send question")
+            }
+            .padding(SuzzmeTheme.Spacing.xs)
+            .background(SuzzmeTheme.backgroundSecondary, in: RoundedRectangle(cornerRadius: SuzzmeTheme.Radius.largeSurface))
+            .overlay { RoundedRectangle(cornerRadius: SuzzmeTheme.Radius.largeSurface).strokeBorder(SuzzmeTheme.separator) }
+            Text("Context is used only through sources you allow.")
+                .font(.caption).foregroundStyle(SuzzmeTheme.textSecondary)
+                .multilineTextAlignment(.center)
+        }
+    }
+
+    private func suggestion(_ title: String, symbol: String, action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            HStack(spacing: SuzzmeTheme.Spacing.small) {
+                Image(systemName: symbol).frame(width: SuzzmeTheme.Spacing.large)
+                Text(title).fixedSize(horizontal: false, vertical: true)
+                Spacer(minLength: 0)
+                Image(systemName: "chevron.right").font(.caption)
+            }.frame(minHeight: SuzzmeTheme.Layout.touchTarget)
+        }
+        .buttonStyle(.plain).foregroundStyle(SuzzmeTheme.textSecondary)
+    }
+
+    private func send() {
+        let question = draft.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !question.isEmpty else { return }
+        submittedDraft = question
+        draft = ""
+        showsAssistant = true
+    }
+
+    private func talk() {
+        submittedDraft = ""
+        showsAssistant = true
+        Task { _ = await environment.invokeSuzzme() }
+    }
+}
+
+/// Context choices expose their actual retention and permissions before use.
+struct ContextChooserView: View {
+    @Environment(\.dismiss) private var dismiss
+    @Environment(AppEnvironment.self) private var environment
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section {
+                    SuzzmeScreenIntroduction(title: "Choose what Suzzme knows", message: "Add only the information you want to use. Each source explains its permissions and how to remove its data.")
+                }
+                Section("On this device") {
+                    NavigationLink { SourcesView() } label: {
+                        Label("Calendar, Reminders & Contacts", systemImage: "tray.2")
+                    }
+                    NavigationLink {
+                        Form { SelectedMessageImportView() }.suzzmeSettingsForm().navigationTitle("Selected text")
+                    } label: { Label("Paste selected text", systemImage: "doc.on.clipboard") }
+                    NavigationLink { MemoryView() } label: {
+                        Label("Personal Memory", systemImage: "square.stack.3d.up")
+                    }
+                }
+                #if os(macOS)
+                Section {
+                    Button {
+                        dismiss()
+                        Task { await environment.askAboutCurrentScreen() }
+                    } label: { Label("Ask about this screen", systemImage: "rectangle.dashed") }
+                } footer: {
+                    Text("Suzzme asks for consent before capturing screen context for a question. You can cancel the request at any time.")
+                }
+                #endif
+                Section {
+                    NavigationLink { SourcesView() } label: { Label("Manage connected services", systemImage: "link") }
+                } footer: {
+                    Text("Pasted Messages text is stored locally for up to 7 days. Files and continuous screen sharing are not available in this version.")
+                }
+            }
+            .suzzmeSettingsForm()
+            .navigationTitle("Context")
+            .toolbar { ToolbarItem(placement: .cancellationAction) { Button("Done") { dismiss() } } }
+        }
+        #if os(macOS)
+        .frame(minWidth: 460, minHeight: 500)
+        #endif
+    }
+}
+
+#Preview("Home") {
+    NavigationStack { HomeView() }.environment(AppEnvironment.preview).environment(AppRouter())
+}
