# Template only. Never put real secrets in this file or in chat.
# npm run setup creates a private .env.local and separate random device token.
COMPOSIO_API_KEY=
SUZZME_CONNECTOR_URL=
SUZZME_USER_ID=
SUZZME_DEVICE_TOKEN=
SUZZME_AUTH_CONFIGS={}
# Keep 'no' until the project verifier is set to your HTTPS origin + /oauth/verify.
SUZZME_CALLBACK_VERIFIER_CONFIGURED=no
